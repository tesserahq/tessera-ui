{
  "name": "tessera-ui",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "./src/main.ts",
  "module": "./src/main.ts",
  "types": "./src/main.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts",
      "require": "./src/main.ts"
    },
    "./layouts": {
      "types": "./src/components/layouts/index.ts",
      "import": "./src/components/layouts/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    },
    "./components/delete-confirmation": {
      "types": "./src/components/delete-confirmation/delete-confirmation.tsx",
      "import": "./src/components/delete-confirmation/delete-confirmation.tsx"
    },
    "./react-router": {
      "types": "./src/react-router/index.ts",
      "import": "./src/react-router/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./theme.css": {
      "style": "./src/styles/theme.css",
      "default": "./src/styles/theme.css"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "npx eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "npx eslint \"src/**/*.{ts,tsx}\" --fix",
    "check": "bun run format && bun run lint && bun run typecheck",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "npx prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\" \"!**/locales/**\"",
    "format:check": "npx prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\" \"!**/locales/**\"",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "link": "bun link",
    "unlink": "bun unlink"
  },
  "peerDependencies": {
    "@auth0/auth0-react": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^6.0.0 || ^7.0.0",
    "tailwindcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.563.0 || ^1.0.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "@eslint/js": "^9.30.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-onboarding": "^10.6.3",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "eslint": "^9.30.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.3",
    "globals": "^17.13.0",
    "lucide-react": "^1.61.0",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "shadcn": "^3.8.4",
    "sonner": "^2.0.8",
    "storybook": "^10.6.3",
    "storybook-addon-remix-react-router": "^7.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4"
  },
  "dependencies": {
    "@epic-web/client-hints": "^1.3.5",
    "axios": "^1.20.0",
    "cmdk": "^1.1.1",
    "cookie": "^1.0.2",
    "radix-ui": "^1.8.1"
  }
}
